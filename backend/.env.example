# ── Database (Neon / Supabase Postgres) ──────────────────────────────
# Get this from your Neon or Supabase project. Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────
# Any long random string. Used to sign JWTs.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Groq AI (Llama 3.3 70B) ──────────────────────────────────────────
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Server ───────────────────────────────────────────────────────────
PORT="4000"
# Comma-separated list of allowed origins for CORS (frontend URLs)
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
